{
  "name": "pass-culture-institutional-public-website",
  "version": "0.1.0",
  "private": true,
  "description": "Le pass Culture, dispositif porté par le ministère de la Culture, a pour but de faciliter l'accès des jeunes de 18 ans à la culture en leur offrant un crédit de 150€ à dépenser sur l'application pass Culture.",
  "license": "MIT",
  "scripts": {
    "build": "yarn generate-faq && yarn generate-sitemap && next build",
    "dev": "next dev --turbo",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:deadcode": "ts-prune",
    "test:lint": "eslint .",
    "test:lint:fix": "eslint . --fix",
    "test:types": "next typegen && yarn tsc --noEmit",
    "postinstall": "node getFaqQuestions.js",
    "generate-faq": "FAQ_STRICT=true node getFaqQuestions.js",
    "generate-sitemap": "ts-node -P tsconfig.scripts.json ./scripts/generateSiteMap.ts"
  },
  "dependencies": {
    "@rc-component/slider": "^1.2.1",
    "@strapi/blocks-react-renderer": "^1.0.2",
    "dotenv": "^18.0.9",
    "firebase": "^13.2.0",
    "next": "16.4.5",
    "next-qrcode": "^2.5.1",
    "pure-react-carousel": "^3.5.1",
    "qs": "^6.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-player": "^3.4.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@strapi/types": "4.26.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/prop-types": "^15.7.15",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prettier": "~3.9.10",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0",
    "vitest-canvas-mock": "^1.2.0"
  },
  "resolutions": {
    "protobufjs": "^7.5.6",
    "fast-uri": "^3.1.2",
    "@casl/ability": "^7.0.0",
    "@grpc/grpc-js": "^1.14.7",
    "@rushstack/node-core-library/ajv": "^8.20.0",
    "qs": "^6.17.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.0"
  },
  "packageManager": "yarn@4.17.0"
}
