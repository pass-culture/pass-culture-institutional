{
  "name": "pass-culture-institutional-public-website",
  "version": "0.1.0",
  "private": true,
  "description": "Le pass Culture, dispositif porté par le ministère de la Culture, a pour but de faciliter l'accès des jeunes de 18 ans à la culture en leur offrant un crédit de 150€ à dépenser sur l'application pass Culture.",
  "license": "MIT",
  "scripts": {
    "build": "yarn generate-faq && yarn generate-sitemap && next build",
    "dev": "next dev --turbo",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:deadcode": "ts-prune",
    "test:lint": "eslint .",
    "test:lint:fix": "eslint . --fix",
    "test:types": "next typegen && yarn tsc --noEmit",
    "postinstall": "node getFaqQuestions.js",
    "generate-faq": "FAQ_STRICT=true node getFaqQuestions.js",
    "generate-sitemap": "ts-node -P tsconfig.scripts.json ./scripts/generateSiteMap.ts"
  },
  "dependencies": {
    "@strapi/blocks-react-renderer": "^1.0.1",
    "dotenv": "^16.4.7",
    "firebase": "^12.14.0",
    "next": "16.2.9",
    "next-qrcode": "^2.5.1",
    "pure-react-carousel": "patch:pure-react-carousel@npm%3A1.35.0#~/.yarn/patches/pure-react-carousel-npm-1.35.0-4c539548d0.patch",
    "qs": "^6.15.2",
    "rc-slider": "^10.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-player": "^2.15.1",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@strapi/types": "4.26.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.41",
    "@types/prop-types": "^15.7.15",
    "@types/qrcode": "^1.5.5",
    "@types/qs": "^6.9.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "prettier": "~3.8.3",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "typescript": "^5",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0",
    "vitest-canvas-mock": "^1.1.4"
  },
  "resolutions": {
    "protobufjs": "^7.5.6",
    "fast-uri": "^3.1.2",
    "@casl/ability": "^7.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.0"
  },
  "packageManager": "yarn@4.17.0"
}
